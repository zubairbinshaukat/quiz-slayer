# Convex deployment URL (https://<name>.convex.cloud). Leave empty to run fully local:
# no leaderboard, device linking or visit counting.
VITE_CONVEX_URL=

# Secret used by `npm run banks:push` to upload answer keys (scripts only, never sent to
# the browser). Must equal BANKS_ADMIN_KEY in the Convex dashboard
# (Settings → Environment Variables). Any long random string.
BANKS_ADMIN_KEY=

# ADMIN_PIN is NOT read from this file: set it only in the Convex dashboard
# (Settings → Environment Variables), 6 digits. It unlocks the hidden /stats page
# (open /stats, then tap the 3D arrow on the 404 page 7 times). If unset, stats login always fails.
